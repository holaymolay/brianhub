# Production-oriented example. For local dev, adjust host/port/paths before copying to .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

BRIANHUB_DB=/var/lib/brianhub/brianhub.sqlite
# Runtime path; deploy.sh overrides this while applying migrations to a new release.
BRIANHUB_MIGRATIONS=/opt/brianhub/current/services/api/db/migrations
BRIANHUB_APP_ORIGIN=https://brianhub.com
BRIANHUB_CORS_ORIGINS=https://brianhub.com

BRIANHUB_OWNER_EMAIL=owner@example.com
BRIANHUB_REQUIRE_AUTH=true
BRIANHUB_ALLOW_HEADER_ACTOR_AUTH=false
BRIANHUB_SESSION_COOKIE_NAME=brianhub_session
BRIANHUB_SESSION_TTL_DAYS=30

# Keep invite tokens visible in the admin API while v1 uses manual invite sharing.
BRIANHUB_EXPOSE_INVITE_TOKEN=true
BRIANHUB_EMAIL_PROVIDER=log
BRIANHUB_EMAIL_FROM=no-reply@brianhub.com

BRIANHUB_BACKUP_DIR=/var/backups/brianhub
BRIANHUB_BACKUP_PREFIX=brianhub
BRIANHUB_BACKUP_ENCRYPTION_KEY=replace-with-generated-secret
BRIANHUB_BACKUP_UPLOAD_DIR=
BRIANHUB_BACKUP_S3_URI=
BRIANHUB_BACKUP_DAILY_KEEP_DAYS=7
BRIANHUB_BACKUP_WEEKLY_KEEP_WEEKS=52
