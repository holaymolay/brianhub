# BrianHub's site blocks ONLY. Install as /etc/caddy/sites/brianhub.caddy,
# picked up by `import sites/*.caddy` in the main Caddyfile.
#
# Never copy this over /etc/caddy/Caddyfile. This host serves other sites from
# the same Caddy, and overwriting the main file removes them along with their
# certificates — on 2026-08-21 that took brianhub.com and pipecam.report down
# together for 16 minutes, dead at the TLS handshake with every on-box signal
# still reading green.

www.brianhub.com {
  redir https://brianhub.com{uri} 308
}

brianhub.com {
  encode zstd gzip

  redir / /apps/web/ 302
  redir /apps/web /apps/web/ 302
  redir /shoppinglist /apps/shopping/ 302
  redir /apps/shopping /apps/shopping/ 302

  @favicon path /favicon.ico /favicon.svg
  rewrite @favicon /apps/web/favicon.svg

  handle /apps/web/* {
    root * /opt/brianhub/current
    file_server
  }

  handle /apps/shopping/* {
    root * /opt/brianhub/current
    @webmanifest path *.webmanifest
    header @webmanifest Content-Type application/manifest+json
    file_server
  }

  handle {
    reverse_proxy 127.0.0.1:3100
  }
}
