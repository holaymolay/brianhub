[Unit]
Description=BrianHub database backup
After=network-online.target

[Service]
Type=oneshot
# Change this to your installation path.
WorkingDirectory=/opt/brianhub
# Optional env file for backup settings (DB path, encryption key, upload destination).
EnvironmentFile=-/etc/default/brianhub-backup
ExecStart=/usr/bin/env node scripts/backup-db.js
ExecStartPost=/usr/bin/env node scripts/restore-check.js

