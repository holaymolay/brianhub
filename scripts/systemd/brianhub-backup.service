[Unit]
Description=BrianHub database backup
After=network-online.target

[Service]
Type=oneshot
User=brianhub
Group=brianhub
WorkingDirectory=/opt/brianhub/current
EnvironmentFile=/etc/brianhub.env
ExecStart=/usr/bin/env node scripts/backup-db.js
ExecStartPost=/usr/bin/env node scripts/restore-check.js
